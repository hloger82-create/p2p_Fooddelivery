{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hloger82-create/p2p_Fooddelivery/data/schema/restaurant.schema.json",
  "title": "RestaurantDataset",
  "type": "object",
  "required": ["regionId", "restaurants"],
  "properties": {
    "regionId": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "restaurants": {
      "type": "array",
      "items": { "$ref": "#/$defs/restaurant" }
    }
  },
  "$defs": {
    "restaurant": {
      "type": "object",
      "required": ["id", "regionId", "name", "address", "orderTypes", "cuisines", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "regionId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": ["string", "null"] },
            "postcode": { "type": ["string", "null"] },
            "city": { "type": ["string", "null"] }
          }
        },
        "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "phone": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"], "format": "uri" },
        "orderUrl": { "type": ["string", "null"], "format": "uri" },
        "orderTypes": {
          "type": "array",
          "items": { "enum": ["WEBSHOP", "PHONE", "PICKUP"] },
          "minItems": 0
        },
        "cuisines": {
          "type": "array",
          "items": {
            "enum": ["PIZZA", "ITALIAN", "DOENER", "TURKISH", "ASIAN", "SUSHI", "BURGER", "AMERICAN", "GRILL", "CHINESE", "VIETNAMESE", "THAI", "INDIAN", "MEXICAN", "GREEK", "OTHER"]
          }
        },
        "cuisineSource": {
          "enum": ["stated", "derived", null],
          "description": "stated = Kueche auf OSM/Website angegeben; derived = im manuellen Review aus den angebotenen Speisen abgeleitet (eigene Schlussfolgerung, Vermerk in notes)"
        },
        "openingHours": { "type": ["string", "null"] },
        "delivers": { "type": "boolean" },
        "pickup": { "type": "boolean" },
        "deliveryAreas": { "type": "array", "items": { "type": "string" } },
        "minOrderValue": { "type": ["number", "null"], "minimum": 0 },
        "deliveryFee": { "type": ["number", "null"], "minimum": 0 },
        "status": { "enum": ["verified", "pending_review", "rejected"] },
        "lastVerified": { "type": ["string", "null"], "format": "date" },
        "featured": {
          "type": "boolean",
          "default": false,
          "description": "bezahlter, klar als 'Featured' gekennzeichneter Eintrag (B2B-Jahresbeitrag, siehe docs/MONETIZATION.md); darf die organische Sortierung nicht veraendern"
        },
        "source": { "type": "string" },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
